# Supabase 대시보드 > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# secret 키(sb_secret_...) 또는 service_role 키. 서버에서만 쓰이며 브라우저로 나가지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# npm run gen-keys 로 만든 값을 붙여넣으세요. 한 번 정하면 바꾸지 마세요.
# ENCRYPTION_KEY를 잃어버리면 저장된 주민등록번호·계좌번호를 복호화할 수 없습니다.
SESSION_SECRET=
ENCRYPTION_KEY=

# 첫 관리자 계정을 만들 때 /setup 화면에서 입력하는 코드
ADMIN_SETUP_CODE=
